{
  "name": "@moneykernel/kernel",
  "version": "0.1.0",
  "private": true,
  "description": "MoneyKernel backend: authentication, contracts, policy orchestration, reservations, approvals, dispatcher, reconciliation, events.",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --import tsx --env-file-if-exists=../../.env src/server.ts",
    "bootstrap": "node --import tsx --env-file-if-exists=../../.env src/seed-cli.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@moneykernel/contracts": "workspace:*",
    "@moneykernel/domain": "workspace:*",
    "@moneykernel/integrations": "workspace:*",
    "@moneykernel/persistence": "workspace:*",
    "fastify": "5.12.3",
    "tsx": "4.23.13",
    "zod": "4.5.4"
  }
}
