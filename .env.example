# MoneyKernel configuration contract (prd.md section 22.1).
# Copy to .env for local use. Never commit .env. Values here grant no access.

NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# Host port the compose database publishes on 127.0.0.1. Change it (and the URLs below) if 5432 is taken locally.
MK_DB_HOST_PORT=5432
# Local development placeholder credential, matching compose.yaml. Not a deployment recommendation.
DATABASE_URL=postgresql://moneykernel:LOCAL_DEV_ONLY@localhost:5432/moneykernel
# Used only by integration/fault tests. Created automatically by docker/initdb.
DATABASE_URL_TEST=postgresql://moneykernel:LOCAL_DEV_ONLY@localhost:5432/moneykernel_test

# REPLAY (default: offline fixtures, virtual funds) | SHADOW | TESTNET. LIVE does not exist.
MONEYKERNEL_MODE=REPLAY
MONEYKERNEL_ACCOUNT_ALIAS=demo-pool

# Exchanged for a short-lived operator session. Generate a random value; never reuse it elsewhere.
OPERATOR_BOOTSTRAP_SECRET=GENERATE_A_RANDOM_SECRET

MCP_ENDPOINT=https://agent.binance.com/mcp/agentic

# disabled | anthropic | openai. The provider SDK reads MODEL_API_KEY on the backend only.
MODEL_PROVIDER=disabled
MODEL_ID=
MODEL_API_KEY=

# Dedicated Spot Testnet credentials only. Mainnet keys are rejected at startup.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

ENABLE_PUBLIC_MUTATIONS=false
LOG_LEVEL=info

# Forbidden in v0.1 and rejected if present: BINANCE_MAINNET_API_KEY, LIVE, SKIP_SAFETY_CHECKS
