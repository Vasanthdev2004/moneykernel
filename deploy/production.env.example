# Copy to deploy/production.env, replace every REPLACE_* value, and chmod 600 on Linux.
MONEYKERNEL_DOMAIN=moneykernel.example.com
ACME_EMAIL=operator@example.com
MONEYKERNEL_IMAGE=moneykernel:shadow

# Use a URL-safe password here. It must match POSTGRES_PASSWORD.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://moneykernel:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@db:5432/moneykernel

MONEYKERNEL_ACCOUNT_ALIAS=shadow-production
OPERATOR_BOOTSTRAP_SECRET=REPLACE_WITH_32_BYTE_RANDOM_SECRET
METRICS_BEARER_TOKEN=REPLACE_WITH_A_DIFFERENT_32_BYTE_RANDOM_SECRET
HTTP_RATE_LIMIT_PER_MINUTE=600

# Keep false for a view-only deployment. Set true only on the private operator deployment.
ENABLE_PUBLIC_MUTATIONS=false

MODEL_PROVIDER=disabled
MODEL_ID=
MODEL_API_KEY=
LOG_LEVEL=info
