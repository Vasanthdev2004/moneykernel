# dependencies / build
node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

# secrets and local config (PRD 18.3: never commit credential-bearing files)
.env
.env.*
!.env.example
!deploy/production.env.example
*.pem
*.key
secrets/
deploy/production.env
deploy/shadow-bootstrap.json
deploy/backups/

# raw, unsanitized integration captures (only sanitized exports are committed)
**/raw/
**/*.raw.json

# logs and OS noise
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# editor
.vscode/
.idea/

# operational state outside the database (paper venue journals, model run traces)
.moneykernel/

# browser test artifacts
test-results/
playwright-report/
