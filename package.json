{
  "name": "moneykernel",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Deterministic capital-control gateway for AI trading agents",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "doctor": "node --env-file-if-exists=.env scripts/doctor.ts",
    "db:migrate": "node --env-file-if-exists=.env packages/persistence/src/cli.ts up",
    "db:status": "node --env-file-if-exists=.env packages/persistence/src/cli.ts status",
    "dev": "pnpm --filter @moneykernel/kernel dev",
    "dev:web": "pnpm --filter @moneykernel/web dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "test:contracts": "vitest run --project contracts",
    "test:integration": "vitest run --project integration",
    "test:fault": "vitest run --project fault",
    "test:e2e": "playwright test",
    "demo:rehearse": "playwright test -c playwright.rehearsal.config.ts --repeat-each 3",
    "demo:scene": "node --env-file-if-exists=.env scripts/demo-scene.ts",
    "demo:shadow": "node --env-file-if-exists=.env scripts/demo-shadow.ts",
    "build": "pnpm typecheck && pnpm --filter @moneykernel/web build",
    "demo:seed": "node --env-file-if-exists=.env scripts/seed-demo.ts",
    "agent:run": "node --env-file-if-exists=.env apps/agents/src/runner.ts",
    "demo:replay": "node --env-file-if-exists=.env scripts/demo-replay.ts",
    "verify:receipt": "node scripts/verify-receipt.ts",
    "secret:generate": "node scripts/generate-secret.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "fast-check": "4.9.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@moneykernel/contracts": "workspace:*",
    "@moneykernel/domain": "workspace:*",
    "@moneykernel/integrations": "workspace:*",
    "@moneykernel/persistence": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Vasanthdev2004/moneykernel.git"
  },
  "homepage": "https://github.com/Vasanthdev2004/moneykernel#readme",
  "bugs": {
    "url": "https://github.com/Vasanthdev2004/moneykernel/issues"
  }
}
